<UserControl x:Class="Stage3_Basics.InitialForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Stage3_Basics"
             mc:Ignorable="d" Foreground="Black">
    <Grid x:Name="MainForm" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <UIElement.RenderTransform>
            <TransformGroup>
                <ScaleTransform/>
                <SkewTransform/>
                <RotateTransform/>
                <TranslateTransform/>
            </TransformGroup>
        </UIElement.RenderTransform>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FF6FCFD2" Offset="1"/>
                <GradientStop Color="#FF2B524F" Offset="0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button x:Name="btnPropEditor" Content="Properties Editor" Click="btnPropEditor_Click" FontFamily="Lucida Bright" FontSize="10" Padding="5,2" Margin="0,0,5,0"/>
            <ComboBox x:Name="cmbPropNames" FontFamily="Lucida Bright" FontSize="10" Width="120" Margin="0,0,5,0"/>
            <TextBox x:Name="txtPropValue" Text="Enter Value" FontFamily="Lucida Bright" FontSize="10" Width="100" Padding="2"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5">
            <Button x:Name="btnZoom" Content="Zoom to ID" Click="btnZoom_Click" FontFamily="Lucida Bright" FontSize="10" Padding="5,2" Margin="0,0,5,0" Width="95"/>
            <TextBox x:Name="txtZoomID" Text="Enter ID" FontFamily="Lucida Bright" FontSize="10" Width="120" Padding="2"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
            <TextBox x:Name="txtChatHistory" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Lucida Bright" FontSize="10" VerticalScrollBarVisibility="Auto" Width="320" Height="200"/>
        </StackPanel>
        
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="5">
            <TextBox x:Name="txtCommandInput" Text="Ask AI ..." TextWrapping="Wrap" AcceptsReturn="True" FontFamily="Lucida Bright" FontSize="10" Width="250" Height="60" Padding="2"/>
            <Button x:Name="btnExecute" Content="Send" Click="btnExecute_Click" FontFamily="Lucida Bright" FontSize="10" Padding="5,2" Margin="5,40,5,0" Width="65"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="5">
            <Button x:Name="btnTagCleaner" Content="Tag Cleaner" Click="btnTagCleaner_Click" FontFamily="Lucida Bright" FontSize="10" Padding="5,2" Margin="0,0,5,0" Width="75"/>
            <Button x:Name="btnValidate" Content="Validate" Click="btnValidate_Click" FontFamily="Lucida Bright" FontSize="10" Padding="5,2" Margin="0,0,5,0" Width="60"/>
            <Button x:Name="btnReport" Content="Report" Click="btnReport_Click" FontFamily="Lucida Bright" FontSize="10" Padding="5,2" Width="60"/>
        </StackPanel>
        
    </Grid>
</UserControl>
